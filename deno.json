{
	"name": "@kaan/env",
	"version": "0.1.5",
	"description": "A simple environment variable loader for Deno",
	"license": "MIT",
	"exports": {
		".": "./mod.ts"
	},
	"publish": {
		"exclude": [
			"hooks/",
			"tests/",
			"coverage/",
			".github/",
			".gitignore",
			"deno.lock"
		]
	},
	"tasks": {
		"dev": "deno run --allow-env --allow-read --watch mod.ts",
		"prettify": "deno fmt **/*.ts",
		"check": "deno check **/*.ts",
		"lint": "deno lint **/*.ts",
		"test": "deno test -A **/*.test.ts",
		"pre-commit": "deno task prettify && deno task lint && deno task check && deno task test"
	},
	"fmt": {
		"lineWidth": 80,
		"indentWidth": 2,
		"useTabs": true,
		"semiColons": true,
		"singleQuote": true,
		"proseWrap": "always",
		"include": ["**/*.ts"]
	},
	"compilerOptions": {
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"useUnknownInCatchVariables": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true
	},
	"deno": {
		"version": "2.9.5"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.19"
	}
}
